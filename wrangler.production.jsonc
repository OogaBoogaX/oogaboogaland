{
  "name": "oogaboogaland-production",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-02",
  "account_id": "1e5c1e8f7c343bf6cabced151b1ae2c6",
  "workers_dev": true,
  "preview_urls": false,
  // oogabooga.land is the site. www is a proxied DNS record that a Redirect Rule in the zone sends to the
  // apex, so it never reaches the Worker. Sign-in works only on SITE_ORIGIN; workers.dev serves the page signed out.
  "routes": [{ "pattern": "oogabooga.land", "custom_domain": true }],
  // Invocation logs off: they would keep every request's URL, a sign-in callback's GitHub code and state among them. The
  // Worker's own console lines stay in Workers Logs; request counts, errors and CPU stay in the Worker's metrics.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    // `npm run build:site` stages the pages here, with worker/_headers.
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker (worker/src/index.js); every other path is served straight from _site.
    "run_worker_first": ["/auth/*", "/api/*", "/poker/*", "/room", "/game/*", "/donations/*", "/inspect", "/media/lectures/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Ooga Chat's private bridge (worker/src/chat-bridge.js), comma-separated: bridge (every operation but hello),
    // outdoor (island voices heard by Ooga Chat's audience), cloud (Ooga Chat speakers on clouds), commons (The Commons
    // from Ooga Chat, read; commons-send lets its members send too). Empty: the bridge answers hello alone. Deploying with
    // it empty is the kill switch (docs/ooga-chat-backend.md).
    // Production: the bridge's operations, The Commons read and sent, island voices outdoors heard by Ooga Chat, and Ooga
    // Chat's speakers drawn on the island's clouds (#659).
    "OOGA_CHAT_FEATURES": "bridge,outdoor,cloud,commons,commons-send",
    // The audience's caps a zone (worker/src/audience.js `limitsOf`, docs/ooga-chat-operations.md): listeners (the release
    // runbook's first step, raised in documented steps), cloud speakers (one a cloud seat), and the reaction fan-out budget
    // in frames a second.
    "AUDIENCE_LISTENERS": "100",
    "AUDIENCE_SPEAKERS": "8",
    "AUDIENCE_FANOUT": "5000",
    // Optional poker: set POKER_SERVICE_URL to the HTTPS service origin and POKER_SERVICE_TOKEN as a secret.
    // Missing either leaves live poker disabled. See docs/poker-integration.md.
    // Redirects, cookies and the Origin check all use this origin.
    "SITE_ORIGIN": "https://oogabooga.land",
    // The production GitHub OAuth App (callback <SITE_ORIGIN>/auth/callback).
    "GITHUB_CLIENT_ID": "Ov23livdIME2GaBaPdAg",
    // The production Realtime SFU app, for voice. Without it voice says unavailable.
    "REALTIME_APP_ID": "c7ad1d5bf43116572f082ebe18011061",
    // Where a hosted game's instance (GAMES, worker/src/game-host.js) is made: eastern North America. Only an object's
    // first making reads it, and it stays there; moving one takes a new version in worker/src/games.js.
    "GAME_LOCATION_HINT": "enam"
    // Secrets, never here: `wrangler secret put GITHUB_CLIENT_SECRET --config wrangler.production.jsonc`, and REALTIME_SECRET.
    // Optional, for the games the Worker hosts: GAME_DEBUG_IDS, account ids, comma-separated, that may pause a hosted
    // game or start it past its first round (staging).
    // Optional, for the Durable Object inspector at /inspect (worker/src/inspect.js): INSPECTOR_IDS, account ids,
    // comma-separated, that may open it; unset, it is off and no object reports anything.
  },
  // Private production replay storage; public reads are served through the Worker.
  // See docs/cloud-hopper-replays.md for validation and bounded retention.
  // Lecture recordings, private, served at /media/lectures/* through the Worker (worker/src/lecture-audio.js) and
  // uploaded by hand before a deploy that names them (`npm --prefix worker run lectures:production`, docs/lectures.md).
  "r2_buckets": [
    { "binding": "CLOUD_HOPPER_REPLAYS", "bucket_name": "oogaboogaland-production-replays" },
    { "binding": "LECTURE_AUDIO", "bucket_name": "oogaboogaland-production-lectures" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oogaboogaland-production",
      "database_id": "6312c56f-7dd3-43ad-a494-9869b714c1d4",
      "migrations_dir": "worker/migrations"
    }
  ],
  // bananapayserver's production Worker, on mainnet: /donations/* goes to its PageApi entrypoint, and /api/me tells
  // the page donations are on. Deploy bananapayserver-production first, or this Worker's deploy fails on the binding.
  "services": [
    { "binding": "DONATIONS", "service": "bananapayserver-production", "entrypoint": "PageApi" },
    // Oogatron, for the sign-in fallback's contributor check and the audience's speaker order: a Worker cannot
    // fetch another of this account's workers.dev addresses, so it is reached by binding (contributor-policy.js).
    { "binding": "OOGATRON", "service": "oogatron" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "GAMES", "class_name": "GameHost" }, { "name": "INSPECTOR", "class_name": "Inspector" }, { "name": "AUDIENCE", "class_name": "Audience" }],
    // Every active object takes new code the moment a deploy lands, dropping its sockets (pages reconnect on their own),
    // rather than Cloudflare's default of running old code for up to 5 minutes while it waits to hibernate: a fix reaches
    // the room at once, and no Worker on new code talks to a Room, GameHost, Inspector or Audience still on the old.
    "code_update_strategy": { "mode": "immediate" }
  },
  // v2: one GameHost a hosted game's instance (worker/src/games.js names them), apart from the island's Room.
  // v4: Ooga Chat's Audience (worker/src/audience.js), one named `audience`, reached only through ChatBridge and the Room.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["GameHost"] }, { "tag": "v3", "new_sqlite_classes": ["Inspector"] }, { "tag": "v4", "new_sqlite_classes": ["Audience"] }],
  // Namespaces are per account: production counts in 1001-1008, staging in 2001-2008.
  "ratelimits": [
    // Opt-in dropout reports per signed-in account, with additional D1 retention and volume caps.
    { "name": "CONNECTION_REPORT_LIMITER", "namespace_id": "1008", "simple": { "limit": 6, "period": 60 } },
    // Poker API and worker delivery per signed-in account.
    { "name": "POKER_LIMITER", "namespace_id": "1004", "simple": { "limit": 240, "period": 60 } },
    // Sign-in starts per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Room connections per player: reconnect backoff stays far under it.
    { "name": "ROOM_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Voice signalling per player: a join is four calls, each change of who is near one or two more.
    { "name": "VOICE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    // Short-lived TURN credentials per player; independent of game and voice signalling limits.
    { "name": "VOICE_ICE_LIMITER", "namespace_id": "1009", "simple": { "limit": 6, "period": 60 } },
    // Questions to Tess per IP, the address used only for this count: the page answers most by itself.
    { "name": "TESS_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    // Public high-score reads per IP; signed-in submissions per account, on separate keys.
    { "name": "HIGHSCORE_LIMITER", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
    // Hosted games' socket connections per player: a page's reconnect backoff stays far under it.
    { "name": "GAME_LIMITER", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } },
    // GitHub profile pictures served from this origin (worker/src/avatar.js), per IP, counted only on an edge miss.
    { "name": "AVATAR_LIMITER", "namespace_id": "1015", "simple": { "limit": 240, "period": 60 } },
    // The World Map's live layer (worker/src/world.js), per IP: a page asks every 10 s while it shows.
    { "name": "WORLD_LIMITER", "namespace_id": "1016", "simple": { "limit": 30, "period": 60 } }
  ],
  // Daily: purge expired sessions and Tess's questions not asked for 90 days.
  "triggers": { "crons": ["0 4 * * *"] }
}
