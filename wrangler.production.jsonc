{
  "name": "oogaboogaland-production",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-02",
  "account_id": "1e5c1e8f7c343bf6cabced151b1ae2c6",
  "workers_dev": true,
  "preview_urls": false,
  // oogabooga.land is the site. www is a proxied DNS record that a Redirect Rule in the zone sends to the
  // apex, so it never reaches the Worker. Sign-in works only on SITE_ORIGIN; workers.dev serves the page signed out.
  "routes": [{ "pattern": "oogabooga.land", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    // `npm run build:site` stages the pages here, with worker/_headers.
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker (worker/src/index.js); every other path is served straight from _site.
    "run_worker_first": ["/auth/*", "/api/*", "/poker/*", "/room", "/game/*", "/donations/*"]
  },
  "vars": {
    // Optional poker: set POKER_SERVICE_URL to the HTTPS service origin and POKER_SERVICE_TOKEN as a secret.
    // Missing either leaves live poker disabled. See docs/poker-integration.md.
    // Redirects, cookies and the Origin check all use this origin.
    "SITE_ORIGIN": "https://oogabooga.land",
    // The production GitHub OAuth App (callback <SITE_ORIGIN>/auth/callback).
    "GITHUB_CLIENT_ID": "Ov23livdIME2GaBaPdAg",
    // The production Realtime SFU app, for voice. Without it voice says unavailable.
    "REALTIME_APP_ID": "c7ad1d5bf43116572f082ebe18011061",
    // Where a hosted game's instance (GAMES, worker/src/game-host.js) is made: eastern North America. Only an object's
    // first making reads it, and it stays there; moving one takes a new version in worker/src/games.js.
    "GAME_LOCATION_HINT": "enam"
    // Secrets, never here: `wrangler secret put GITHUB_CLIENT_SECRET --config wrangler.production.jsonc`, and REALTIME_SECRET.
    // Optional, for the games the Worker hosts: GAME_DEBUG_IDS, account ids, comma-separated, that may pause a hosted
    // game or start it past its first round (staging).
  },
  // Private production replay storage; public reads are served through the Worker.
  // See docs/cloud-hopper-replays.md for validation and bounded retention.
  "r2_buckets": [{ "binding": "CLOUD_HOPPER_REPLAYS", "bucket_name": "oogaboogaland-production-replays" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oogaboogaland-production",
      "database_id": "6312c56f-7dd3-43ad-a494-9869b714c1d4",
      "migrations_dir": "worker/migrations"
    }
  ],
  // bananapayserver's production Worker, on mainnet: /donations/* goes to its PageApi entrypoint, and /api/me tells
  // the page donations are on. Deploy bananapayserver-production first, or this Worker's deploy fails on the binding.
  "services": [{ "binding": "DONATIONS", "service": "bananapayserver-production", "entrypoint": "PageApi" }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "GAMES", "class_name": "GameHost" }]
  },
  // v2: one GameHost a hosted game's instance (worker/src/games.js names them), apart from the island's Room.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["GameHost"] }],
  // Namespaces are per account: production counts in 1001-1008, staging in 2001-2008.
  "ratelimits": [
    // Poker API and worker delivery per signed-in account.
    { "name": "POKER_LIMITER", "namespace_id": "1004", "simple": { "limit": 240, "period": 60 } },
    // Sign-in starts per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Room connections per player: reconnect backoff stays far under it.
    { "name": "ROOM_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Voice signalling per player: a join is four calls, each change of who is near one or two more.
    { "name": "VOICE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    // Short-lived TURN credentials per player.
    { "name": "VOICE_ICE_LIMITER", "namespace_id": "1008", "simple": { "limit": 6, "period": 60 } },
    // Questions to Tess per IP, the address used only for this count: the page answers most by itself.
    { "name": "TESS_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    // Public high-score reads per IP; signed-in submissions per account, on separate keys.
    { "name": "HIGHSCORE_LIMITER", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
    // Hosted games' socket connections per player: a page's reconnect backoff stays far under it.
    { "name": "GAME_LIMITER", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } }
  ],
  // Daily: purge expired sessions and Tess's questions not asked for 90 days.
  "triggers": { "crons": ["0 4 * * *"] }
}
