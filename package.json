{
  "name": "oogaboogaland",
  "version": "0.1.0",
  "description": "EntropyLab contributor vivarium: a WebGL2 lab where donated bananas feed the Ooga Boogas",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "watch": "node scripts/serve.mjs --watch",
    "characters": "node scripts/characters.mjs --list",
    "characters:json": "node scripts/characters.mjs --json",
    "test:unit": "LANE=unit node test/run.mjs",
    "test": "node scripts/build.mjs && LANE=fast node test/run.mjs",
    "test:canvas": "node scripts/build.mjs && LANE=canvas node test/run.mjs",
    "test:perf": "node scripts/build.mjs && LANE=perf LANES=1 node test/run.mjs",
    "test:full": "node scripts/build.mjs && LANE=full node test/run.mjs"
  }
}
