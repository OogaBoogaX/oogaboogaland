{
  "name": "oogaboogaland-staging",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-02",
  "account_id": "1e5c1e8f7c343bf6cabced151b1ae2c6",
  "workers_dev": true,
  "preview_urls": false,
  // Invocation logs off: they would keep every request's URL, a sign-in callback's GitHub code and state among them. The
  // Worker's own console lines stay in Workers Logs; request counts, errors and CPU stay in the Worker's metrics.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    // `npm run build:site` stages the pages here, with worker/_headers.
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker (worker/src/index.js); every other path is served straight from _site.
    "run_worker_first": ["/auth/*", "/api/*", "/poker/*", "/room", "/game/*", "/donations/*", "/inspect", "/media/lectures/*"]
  },
  "vars": {
    "ENVIRONMENT": "staging",
    // Account hats are enabled explicitly for staging acceptance; production remains off.
    "EQUIPMENT_ENABLED": "1",
    // Independent character catalogs stay off until the runtime and publisher acceptance checks pass.
    // Enabling also requires CHARACTER_CATALOGS, CHARACTER_CATALOG_ENGINE and CHARACTER_CATALOG_BASELINE.
    "CHARACTER_CATALOG_ENABLED": "0",
    // Ooga Chat's private bridge (worker/src/chat-bridge.js), comma-separated: bridge (every operation but hello),
    // outdoor (island voices heard by Ooga Chat's audience), cloud (Ooga Chat speakers on clouds), commons (The Commons
    // from Ooga Chat, read; commons-send lets its members send too). Empty: the bridge answers hello alone. Deploying with
    // it empty is the kill switch (docs/ooga-chat-backend.md).
    // Staging: the bridge's operations (the contributor answer, revocations, readiness), The Commons, read and sent
    // (#656's staging check), and outdoor voice (#654's staging check): island players speaking outdoors in Main Island or
    // DSB Land are heard in Ooga Chat, and Ooga Chat's speakers there are heard on the island and drawn on its clouds (#659).
    "OOGA_CHAT_FEATURES": "bridge,commons,commons-send,outdoor,cloud",
    // The audience's caps a zone (worker/src/audience.js `limitsOf`, docs/ooga-chat-operations.md): listeners (the proposed
    // launch envelope, for the staging matrix), cloud speakers (one a cloud seat), and the reaction fan-out budget in frames
    // a second.
    "AUDIENCE_LISTENERS": "500",
    "AUDIENCE_SPEAKERS": "8",
    "AUDIENCE_FANOUT": "5000",
    // Optional poker: set POKER_SERVICE_URL to the HTTPS service origin and POKER_SERVICE_TOKEN as a secret.
    // Missing either leaves live poker disabled. See docs/poker-integration.md.
    // Redirects, cookies and the Origin check all use this origin.
    "SITE_ORIGIN": "https://oogaboogaland-staging.wickedsmartbitcoin.workers.dev",
    // The staging GitHub OAuth App (callback <SITE_ORIGIN>/auth/callback).
    "GITHUB_CLIENT_ID": "Ov23linQJ9cQNA53pUFm",
    // The staging Realtime SFU app, for voice. Without it voice says unavailable.
    "REALTIME_APP_ID": "7a612c25157c668f433c6167adb3887e"
    // Secrets, never here: `wrangler secret put GITHUB_CLIENT_SECRET --config wrangler.staging.jsonc`, and REALTIME_SECRET.
    // Optional, for the games the Worker hosts (GAMES, worker/src/game-host.js): GAME_LOCATION_HINT, a region such as
    // "enam" an instance's object is made in (else near whoever first connects; it stays there), and GAME_DEBUG_IDS,
    // account ids, comma-separated, that may pause a hosted game or start it past its first round (staging).
    // Optional, for the Durable Object inspector at /inspect (worker/src/inspect.js): INSPECTOR_IDS, account ids,
    // comma-separated, that may open it; unset, it is off and no object reports anything.
  },
  // Private staging replay storage; public reads are served through the Worker.
  // See docs/cloud-hopper-replays.md for validation and bounded retention.
  // Lecture recordings, private, served at /media/lectures/* through the Worker (worker/src/lecture-audio.js) and
  // uploaded by hand before a deploy that names them (`npm --prefix worker run lectures:staging`, docs/lectures.md).
  "r2_buckets": [
    { "binding": "CLOUD_HOPPER_REPLAYS", "bucket_name": "oogaboogaland-staging-replays" },
    { "binding": "LECTURE_AUDIO", "bucket_name": "oogaboogaland-staging-lectures" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oogaboogaland-staging",
      "database_id": "97cdec13-2f51-4f27-9bfc-54eb83bb1bf1",
      "migrations_dir": "worker/migrations"
    }
  ],
  // bananapayserver's staging Worker, on signet: /donations/* goes to its PageApi entrypoint, and /api/me tells the
  // page donations are on. Deploy bananapayserver-staging first.
  "services": [
    { "binding": "DONATIONS", "service": "bananapayserver-staging", "entrypoint": "PageApi" },
    // Oogatron, for the sign-in fallback's contributor check and the audience's speaker order: a Worker cannot
    // fetch another of this account's workers.dev addresses, so it is reached by binding (contributor-policy.js).
    { "binding": "OOGATRON", "service": "oogatron" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "GAMES", "class_name": "GameHost" }, { "name": "INSPECTOR", "class_name": "Inspector" }, { "name": "AUDIENCE", "class_name": "Audience" }, { "name": "WORLD", "class_name": "WorldWatch" }],
    // Every active object takes new code the moment a deploy lands, dropping its sockets (pages reconnect on their own),
    // rather than Cloudflare's default of running old code for up to 5 minutes while it waits to hibernate: a fix reaches
    // the room at once, and no Worker on new code talks to a Room, GameHost, Inspector or Audience still on the old.
    "code_update_strategy": { "mode": "immediate" }
  },
  // v2: one GameHost a hosted game's instance (worker/src/games.js names them), apart from the island's Room.
  // v4: Ooga Chat's Audience (worker/src/audience.js), one named `audience`, reached only through ChatBridge and the Room.
  // v5: the World Map's WorldWatch (worker/src/world-watch.js), one named `world`, which map pages listen to.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["GameHost"] }, { "tag": "v3", "new_sqlite_classes": ["Inspector"] }, { "tag": "v4", "new_sqlite_classes": ["Audience"] }, { "tag": "v5", "new_sqlite_classes": ["WorldWatch"] }],
  // Namespaces are per account: staging counts in 2001-2008, production in 1001-1008.
  "ratelimits": [
    // Equipment reads and saves per signed-in account, counted on separate method keys.
    { "name": "EQUIPMENT_LIMITER", "namespace_id": "2017", "simple": { "limit": 30, "period": 60 } },
    // Opt-in dropout reports per signed-in account, with additional D1 retention and volume caps.
    { "name": "CONNECTION_REPORT_LIMITER", "namespace_id": "2008", "simple": { "limit": 6, "period": 60 } },
    // Poker API and worker delivery per signed-in account.
    { "name": "POKER_LIMITER", "namespace_id": "2004", "simple": { "limit": 240, "period": 60 } },
    // Sign-in starts per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    // Room connections per player: reconnect backoff stays far under it.
    { "name": "ROOM_LIMITER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
    // Voice signalling per player: a join is four calls, each change of who is near one or two more.
    { "name": "VOICE_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    // Short-lived TURN credentials per player; independent of game and voice signalling limits.
    { "name": "VOICE_ICE_LIMITER", "namespace_id": "2009", "simple": { "limit": 6, "period": 60 } },
    // Questions to Tess per IP, the address used only for this count: the page answers most by itself.
    { "name": "TESS_LIMITER", "namespace_id": "2005", "simple": { "limit": 5, "period": 60 } },
    // Public high-score reads per IP; signed-in submissions per account, on separate keys.
    { "name": "HIGHSCORE_LIMITER", "namespace_id": "2006", "simple": { "limit": 120, "period": 60 } },
    // Hosted games' socket connections per player: a page's reconnect backoff stays far under it.
    { "name": "GAME_LIMITER", "namespace_id": "2007", "simple": { "limit": 20, "period": 60 } },
    // GitHub profile pictures served from this origin (worker/src/avatar.js), per IP, counted only on an edge miss.
    { "name": "AVATAR_LIMITER", "namespace_id": "2015", "simple": { "limit": 240, "period": 60 } },
    // The World Map's live layer (worker/src/world.js), per IP: a page asks every 2 s while it shows, so a few tabs
    // behind one address fit.
    { "name": "WORLD_LIMITER", "namespace_id": "2016", "simple": { "limit": 120, "period": 60 } }
  ],
  // Daily: purge expired sessions and Tess's questions not asked for 90 days.
  "triggers": { "crons": ["0 4 * * *"] }
}
