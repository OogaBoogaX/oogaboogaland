{
  "name": "oogaboogaland-staging",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-02",
  "account_id": "1e5c1e8f7c343bf6cabced151b1ae2c6",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    // `npm run build:site` stages the pages here, with worker/_headers.
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker (worker/src/index.js); every other path is served straight from _site.
    "run_worker_first": ["/auth/*", "/api/*", "/poker/*", "/room", "/game/*", "/donations/*", "/inspect"]
  },
  "vars": {
    // Optional poker: set POKER_SERVICE_URL to the HTTPS service origin and POKER_SERVICE_TOKEN as a secret.
    // Missing either leaves live poker disabled. See docs/poker-integration.md.
    // Redirects, cookies and the Origin check all use this origin.
    "SITE_ORIGIN": "https://oogaboogaland-staging.wickedsmartbitcoin.workers.dev",
    // The staging GitHub OAuth App (callback <SITE_ORIGIN>/auth/callback).
    "GITHUB_CLIENT_ID": "Ov23linQJ9cQNA53pUFm",
    // The staging Realtime SFU app, for voice. Without it voice says unavailable.
    "REALTIME_APP_ID": "7a612c25157c668f433c6167adb3887e"
    // Secrets, never here: `wrangler secret put GITHUB_CLIENT_SECRET --config wrangler.staging.jsonc`, and REALTIME_SECRET.
    // Optional, for the games the Worker hosts (GAMES, worker/src/game-host.js): GAME_LOCATION_HINT, a region such as
    // "enam" an instance's object is made in (else near whoever first connects; it stays there), and GAME_DEBUG_IDS,
    // account ids, comma-separated, that may pause a hosted game or start it past its first round (staging).
    // Optional, for the Durable Object inspector at /inspect (worker/src/inspect.js): INSPECTOR_IDS, account ids,
    // comma-separated, that may open it; unset, it is off and no object reports anything.
  },
  // Private staging replay storage; public reads are served through the Worker.
  // See docs/cloud-hopper-replays.md for validation and bounded retention.
  "r2_buckets": [{ "binding": "CLOUD_HOPPER_REPLAYS", "bucket_name": "oogaboogaland-staging-replays" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oogaboogaland-staging",
      "database_id": "97cdec13-2f51-4f27-9bfc-54eb83bb1bf1",
      "migrations_dir": "worker/migrations"
    }
  ],
  // bananapayserver's staging Worker, on signet: /donations/* goes to its PageApi entrypoint, and /api/me tells the
  // page donations are on. Deploy bananapayserver-staging first.
  "services": [{ "binding": "DONATIONS", "service": "bananapayserver-staging", "entrypoint": "PageApi" }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "GAMES", "class_name": "GameHost" }, { "name": "INSPECTOR", "class_name": "Inspector" }]
  },
  // v2: one GameHost a hosted game's instance (worker/src/games.js names them), apart from the island's Room.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["GameHost"] }, { "tag": "v3", "new_sqlite_classes": ["Inspector"] }],
  // Namespaces are per account: staging counts in 2001-2008, production in 1001-1008.
  "ratelimits": [
    // Opt-in dropout reports per signed-in account, with additional D1 retention and volume caps.
    { "name": "CONNECTION_REPORT_LIMITER", "namespace_id": "2008", "simple": { "limit": 6, "period": 60 } },
    // Poker API and worker delivery per signed-in account.
    { "name": "POKER_LIMITER", "namespace_id": "2004", "simple": { "limit": 240, "period": 60 } },
    // Sign-in starts per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    // Room connections per player: reconnect backoff stays far under it.
    { "name": "ROOM_LIMITER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
    // Voice signalling per player: a join is four calls, each change of who is near one or two more.
    { "name": "VOICE_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    // Short-lived TURN credentials per player; independent of game and voice signalling limits.
    { "name": "VOICE_ICE_LIMITER", "namespace_id": "2009", "simple": { "limit": 6, "period": 60 } },
    // Questions to Tess per IP, the address used only for this count: the page answers most by itself.
    { "name": "TESS_LIMITER", "namespace_id": "2005", "simple": { "limit": 5, "period": 60 } },
    // Public high-score reads per IP; signed-in submissions per account, on separate keys.
    { "name": "HIGHSCORE_LIMITER", "namespace_id": "2006", "simple": { "limit": 120, "period": 60 } },
    // Hosted games' socket connections per player: a page's reconnect backoff stays far under it.
    { "name": "GAME_LIMITER", "namespace_id": "2007", "simple": { "limit": 20, "period": 60 } }
  ],
  // Daily: purge expired sessions and Tess's questions not asked for 90 days.
  "triggers": { "crons": ["0 4 * * *"] }
}
